# CAREX Backend Environment Variables
PROJECT_NAME="CAREX Healthcare Information System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="carex-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/carex_db
# PostgreSQL (Local):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carex_db
# SQLite (Local zero-config dev):
DATABASE_URL=sqlite:///./carex.db

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:80","http://localhost"]

# Logging
LOG_LEVEL="INFO"
